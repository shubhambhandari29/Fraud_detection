# Copy this file to .env and supply the same server/authentication values used by SAC.
DB_SERVER=
DB_NAME=CLMDS_DataModelingAndTextMining
DB_DRIVER={ODBC Driver 18 for SQL Server}
DB_AUTH=ActiveDirectoryInteractive
DB_CONNECTION_TIMEOUT=15

# Replace this with a long random value outside local development.
SECRET_KEY=
ACCESS_TOKEN_VALIDITY=30
REFRESH_TOKEN_VALIDITY=10080
SECURE_COOKIE=false
SAME_SITE=lax
